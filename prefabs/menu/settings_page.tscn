[sub_resource type="Shader" id=56]
code = "shader_type canvas_item;

void fragment() {
	vec2 muv = (UV - vec2(0.5)) * 2.0;
	float m = 1.0 - max(abs(muv.x),abs(muv.y));
	COLOR = texture(TEXTURE,UV)*(1.0 + clamp((m*1.5+0.5),0,1.0))/2.0;
}"

[sub_resource type="ShaderMaterial" id=43]
shader = SubResource( 56 )

[sub_resource type="Shader" id=57]
code = "shader_type canvas_item;

void fragment() {
	vec2 uv = UV + vec2(TIME * -0.2);
	COLOR.rgb = texture(TEXTURE,UV).rgb * (0.75 + (0.25 * sin(length(uv*6.285))));
}"

[sub_resource type="ShaderMaterial" id=44]
